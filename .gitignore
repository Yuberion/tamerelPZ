# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/
.pnp/
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------------------------------------------------------------------------
# Build output. Root-anchored on purpose: unanchored `dist/` or `build/` also
# match nested source directories like src/renderer/src/lib/dist/.
#
# `build/` is deliberately NOT ignored — it is electron-builder's default
# buildResources directory (app icon, entitlements, installer scripts), which
# belongs in the repo.
#
# Packaged artifacts (*.exe, *.msi, *.zip, ...) need no rules of their own:
# they land inside the ignored output directories below, and unanchored
# extension globs would silently drop legitimate committed assets anywhere in
# the tree while contradicting the binary attributes in .gitattributes.
# ---------------------------------------------------------------------------
/out/
/dist/
/dist-electron/
/release/
/*.asar

# ---------------------------------------------------------------------------
# TypeScript incremental build info
# ---------------------------------------------------------------------------
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Caches
# ---------------------------------------------------------------------------
.cache/
.temp/
.tmp/
.vite/
.eslintcache
.stylelintcache
.turbo/
.parcel-cache/

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------------------------------------------------------------------------
# Environment / secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# ---------------------------------------------------------------------------
# Editors & IDEs
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ---------------------------------------------------------------------------
# Agent / tooling local state
# Note: .kilo/command/ and .kilo/agent/ are shareable project config —
# only local/recovery state and tooling caches are ignored here.
# `.kilo/worktrees/` holds full checkouts of this repo and must never be added.
# ---------------------------------------------------------------------------
.kilo/agent-manager.json
.kilo/state/
.kilo/cache/
.kilo/node_modules/
.kilo/worktrees/
.kilocode/
.opencode/
.claude/
.aider*

# ---------------------------------------------------------------------------
# OS cruft
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
